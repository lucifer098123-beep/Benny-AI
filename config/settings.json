{
  "agent": {
    "name": "benny",
    "version": "0.1.0",
    "default_verbosity": "concise",
    "thinking_threshold": 0.6
  },
  "paths": {
    "memory_dir": "data/memory",
    "audit_dir": "data/audit",
    "log_dir": "data/logs"
  },
  "memory": {
    "budget": {
      "hot_max_episodes": 200,
      "hot_max_kb": 5120,
      "warm_max_nodes": 2000,
      "cold_max_nodes": 20000,
      "vault_max_mb": 2048,
      "promote_hot_to_warm": true,
      "promote_warm_to_cold": true,
      "promote_cold_to_ancient": true
    }
  },
  "ram": {
    "budget": {
      "target_total_mb": 2048,
      "model_resident_mb": 1536,
      "hot_working_mb": 256,
      "tools_resident_mb": 128,
      "headroom_mb": 128,
      "hard_fail_gb": 32,
      "max_hot_mb": 256,
      "evict_hot_when_over": true
    }
  },
  "brain": {
    "mode": "ollama",
    "router": null,
    "workhorse": "llama3.2:3b",
    "brain": null,
    "cloud": {
      "provider": null,
      "endpoint": null,
      "max_requests_per_day": 500
    }
  },
  "security": {
    "fingerprint": {
      "enabled": false,
      "device_ids": []
    },
    "auto_lock": {
      "idle_timeout_seconds": 600,
      "lock_on_screen": true
    },
    "tamper": {
      "max_failures": 3,
      "decoy_enabled": true,
      "wipe_on_extreme": false
    }
  },
  "gatekeeper": {
    "default_deny": true,
    "https_only": true,
    "no_ip_urls": true,
    "allow_domains": [],
    "allow_regex": [],
    "ask_on_new": true,
    "audit_enabled": true,
    "blocked_topics": ["political propaganda", "engagement bait", "unverified claims"]
  }
}
